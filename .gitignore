# Secrets and machine-specific state — never commit.
profiles.json
.env
.env.*
!/.env.example
*.plist
!deploy/**/*.plist
hwconfig.plist
gsa.plist
state.plist

# Apple's binary is fetched as data at runtime, never redistributed.
IMDAppleServices

# Rust
target/
**/target/

# Python (bridge)
bridge/.venv/
**/__pycache__/
*.pyc
.pytest_cache/

# APK build outputs
aka-oracle/build/

# Local scratch
*.log

# Machine state (registration, keys, relay secret) — never commit.
data/
relay-secret
