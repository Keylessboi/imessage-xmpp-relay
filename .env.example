# openbubbles-relay / imessage-xmpp-relay - environment reference.
#
# Copy to .env and fill in your own values. The real .env is gitignored and must
# never be committed. NOTHING here is a working value: every entry is a
# placeholder, and the ids in the docs (+15551234567, you@example.org,
# xmpp.example.org) are placeholders too.
#
# The code reads only environment variables; there are no compiled-in
# credentials. Two services have their own variables, and the crates share a
# few names, so they are grouped below.

# =============================================================================
# crates/imessage-server + crates/imessage-server-rustpush (the :8790 server)
# =============================================================================

# --- Account (optional; the phone-number path does NOT need an Apple ID) ---
# Use an *app-specific* password from appleid.apple.com, never the account
# password and never a 2FA code.
IMESSAGE_APPLE_ID=
IMESSAGE_APPLE_PASSWORD=
# Alternative to IMESSAGE_APPLE_PASSWORD: the SHA-256 of the password, hex.
# IMESSAGE_APPLE_PASSWORD_SHA256=

# --- Runtime ---
# Where hwconfig.plist / gsa.plist / state.plist / anisette/ live. Default /data.
# This directory holds the registration: back it up, never commit it.
# IMESSAGE_DATA_DIR=./data
# Listen address for the HTTP API. The bridge points at this.
# LISTEN=127.0.0.1:8790
# Rust log filter, e.g. info,rustpush::util=warn
# RUST_LOG=info

# --- Device identity ---
# Base64 of a complete hwconfig.plist, instead of a file in IMESSAGE_DATA_DIR.
# IMESSAGE_HWCONFIG_PLIST_BASE64=
#
# Registration relay: a self-hosted beeper/registration-relay bridged to a
# jailbroken iPhone running JJTech's ValidationRelay. When both are set, the
# device identity is iPhone-class (required to register a phone number). Leave
# unset to fall back to the MacOSConfig identity from hwconfig.plist.
# REGISTRATION_RELAY_URL=ws://127.0.0.1:8000/api/v1/provider
# REGISTRATION_RELAY_CODE=
# REGISTRATION_RELAY_VALIDATE_AUTH_URL   (set on the *relay* container, not here;
#   leave it unset on a self-hosted relay so no Beeper account is required)

# --- Anisette (Apple attestation) ---
# Base URL of an anisette-v3 backend. Default https://ani.sidestore.io.
# ANISETTE_URL=
# OMNISETTE_URL_V3=

# --- Phone-number registration (one-time, needs the SIM's handset) ---
# The server exposes POST /im/register-phone; scripts/activate-number.sh posts
# to it. It also reads the APNs token from GET /apns-token. There is no
# variable for the number: it is whatever SIM answered the REG-REQ.

# --- Apple ID login retry (only if you use the Apple ID path) ---
# Seconds between login attempts; 0 disables retrying. 0..3600, default 1800.
# IMESSAGE_LOGIN_RETRY_SECS=1800

# --- SMS 2FA read off an adb handset (only if you use the Apple ID path) ---
# Serial of the handset holding the Apple ID's SIM.
# IMESSAGE_ADB_SERIAL=0123456789ABCDEF
# The trusted phone's GSA id (the fork's icloud-auth reads this; default 1).
# IMESSAGE_2FA_PHONE_ID=1
# The trusted phone number GSA reports for the account (informational).
# IMESSAGE_2FA_PHONE=
# Override the whole SMS read with a code you already have.
# IMESSAGE_2FA_CODE=
# Alternative: put the code in <data_dir>/2fa.txt
# (test-only) make the adb SMS test use the real handset.
# SMS2FA_LIVE=1

# =============================================================================
# crates/openbubbles-relay (the validation-data relay, :8787)
# =============================================================================

# Path to profiles.json: bearer code -> hardware profile. This is a secret
# (it maps a code to a device identity); it is gitignored and mounted, never
# baked into an image.
# PROFILES_FILE=./profiles.json
# Listen address. Default 0.0.0.0:8787.
# LISTEN=127.0.0.1:8787
# Cache directory for Apple's downloaded IMDAppleServices binary.
# Defaults to $XDG_CACHE_HOME/open-absinthe (or ~/.cache/open-absinthe).
# XDG_CACHE_HOME=
# Explicit path to an already-downloaded IMDAppleServices binary.
# OPEN_ABSINTHE_IMD=

# =============================================================================
# bridge (XMPP <-> iMessage)
# =============================================================================

# --- Transport mode ---
# "client" (a logged-in bot account, the default) or "component" (XEP-0114).
# XMPP_MODE=client

# --- client mode (required) ---
# XMPP_JID=you@example.org
# XMPP_PASSWORD=
# XMPP_SERVER=xmpp.example.org        (or host:5223)
# XMPP_PORT=5222
# XMPP_INSECURE_TLS=0
# XMPP_DIRECT_TLS=0

# --- component mode (XEP-0114) ---
# COMPONENT_JID=imessage.example.org
# COMPONENT_DOMAIN=imessage.example.org
# COMPONENT_HOST=127.0.0.1
# COMPONENT_PORT=5347
# COMPONENT_SECRET=
# COMPONENT_OWNER=you@example.org     (the only JID allowed to send)

# --- Where inbound iMessages go (at least one of TARGET / MUC / CONTACTS) ---
# XMPP_TARGET=you@example.org
# XMPP_MUC=imessage@rooms.example.org
# XMPP_MUC_NICK=imessage
# XMPP_CONTACTS=+15551234567=you@example.org,friend@example.org=friend@example.org
# XMPP_NO_SENDER_PREFIX=0
# XMPP_ALLOWED=you@example.org        (bare JIDs; EMPTY = DENY EVERYONE)

# --- Upstream (the :8790 server) ---
# IMESSAGE_API_URL=http://127.0.0.1:8790
# IMESSAGE_DEFAULT_TO=+15557654321    (fallback target for XMPP -> iMessage)

# --- OMEMO 2 (1:1 chats only; off by default) ---
# XMPP_OMEMO=0
# XMPP_OMEMO_STORE=./omemo-store.json  (required when XMPP_OMEMO=1)
# XMPP_OMEMO_BTBV=1

# --- Resilience / limits ---
# REQUEST_TIMEOUT=15
# DEDUP_SIZE=4096
# BACKOFF_INITIAL=1.0
# BACKOFF_FACTOR=2.0
# BACKOFF_MAX=60.0
# BACKOFF_JITTER=0.5
# HEALTHY_STREAM_AFTER=30.0
# LOG_LEVEL=INFO

# =============================================================================
# scripts/
# =============================================================================

# scripts/activate-number.sh
# API=http://127.0.0.1:8790
# SERIAL=0123456789ABCDEF            (adb serial of the handset with the SIM)
# PKG=com.openbubbles.aka
# GATEWAY=22223333                   (carrier REG gateway shortcode)
# WAIT_SECS=120

# aka-oracle/build.sh
# ANDROID_SDK_ROOT=                  (or ANDROID_HOME=)
# KS=build/oracle.keystore
# KS_PASS=android
# KS_ALIAS=oracle
